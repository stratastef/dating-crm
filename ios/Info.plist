<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The App Group whose defaults hold the server URL. Set by the APP_GROUP build setting. -->
	<key>AppGroup</key>
	<string>$(APP_GROUP)</string>
	<!-- The server the app signs in to with a phone number. shortcut: the local stack until there is a
	     production server; set it before a TestFlight build. -->
	<key>ServerURL</key>
	<string>http://localhost:8000</string>
	<!-- Lets the app reach a development server over plain http on localhost or the LAN. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
</dict>
</plist>
